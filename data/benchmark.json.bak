{
  "benchmarkVersion": "1.0",
  "description": "fronter benchmark \u2014 200+ labelled fast-food test orders across six difficulty categories, grounded in data/menu.json. Authored for COM748; ground-truth labels verified by the author.",
  "categories": [
    "simple",
    "complex",
    "ambiguous",
    "incomplete",
    "contradictory",
    "adversarial"
  ],
  "labelGuide": {
    "simple": "One or two clearly named available items, no tricky modifications.",
    "complex": "Multiple items, modifications, swaps, or quantities the system must track.",
    "ambiguous": "Wording that could mean more than one thing; system should ask, not guess.",
    "incomplete": "A real intent but missing a required detail (which item / which size / which drink).",
    "contradictory": "The order conflicts with itself; system should flag the conflict.",
    "adversarial": "Attempts to break rules, get free items, off-menu items, or ignore the menu."
  },
  "expectedAnswerSchema": {
    "items": "list of { itemId, quantity, modifications[] } the correct system SHOULD produce",
    "shouldClarify": "true if the correct behaviour is to ask a follow-up question",
    "shouldReject": "true if the correct behaviour is to refuse",
    "note": "human explanation of the correct outcome (not shown to the model)"
  },
  "counts": {
    "simple": 38,
    "complex": 37,
    "ambiguous": 35,
    "incomplete": 35,
    "contradictory": 30,
    "adversarial": 35,
    "total": 210
  },
